# Copy to .env.local for local dev, or set these in Vercel → Project → Settings
# → Environment Variables for production. Both are optional — the site works
# fully without them; each feature just stays off until its value is set.

# Google Analytics 4 measurement ID (Analytics → Admin → Data Streams → your stream).
# Looks like G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console site-ownership verification code (Search Console → Settings
# → Ownership verification → HTML tag method → the "content" value only, not the
# whole <meta> tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
